
#include <stdio.h>

int main()
{
    int n, i, count = 0;

    printf("My name is Raj Gupta , program 18 is solved\n");
    printf("Enter a number: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++)
    {
        if(i % 3 == 0 && i % 5 != 0)
        {
            printf("%d ", i);
            count++;
        }
    }

    printf("\nTotal numbers = %d", count);

    return 0;
}
